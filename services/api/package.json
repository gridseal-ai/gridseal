{
  "name": "@gridseal/api",
  "version": "0.1.0",
  "description": "REST API for GridSeal audit trail management",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup --tsconfig tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:uat": "vitest run --config vitest.uat.config.ts",
    "test:performance": "vitest run --config vitest.performance.config.ts",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "audit-trail",
    "gridseal",
    "api",
    "hono"
  ],
  "author": "Gridseal",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/gridseal-ai/gridseal.git",
    "directory": "services/api"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@gridseal/core": "workspace:*",
    "@gridseal/trust-page": "workspace:*",
    "@hono/node-server": "^1.14.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.10",
    "pg": "^8.20.0",
    "pino": "^9.7.0",
    "zod": "^3.25.3"
  },
  "devDependencies": {
    "@gridseal/sdk-node": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.2",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.2",
    "better-sqlite3": "^12.8.0",
    "drizzle-kit": "^0.31.10",
    "tsup": "^8.5.1",
    "tsx": "^4.19.4",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
