{
  "name": "@gridseal/cli",
  "version": "0.1.0",
  "description": "CLI for GridSeal chain verification and inspection",
  "type": "module",
  "bin": {
    "gridseal": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup --tsconfig tsconfig.build.json",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "audit-trail",
    "chain-verification",
    "gridseal",
    "cli"
  ],
  "author": "Gridseal by Celestir",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/celestir/gridseal.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@gridseal/core": "workspace:*",
    "better-sqlite3": "^12.8.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.2",
    "@vitest/coverage-v8": "^4.1.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
